# All credentials stay on the server. This file is never loaded automatically.
PATCHFORGE_API_KEY=replace-locally
PATCHFORGE_BASE_URL=https://api.deepseek.com
PATCHFORGE_MODEL=deepseek-flash
# Optional: separate credential file; loaded explicitly, never searched in parent folders.
# Start with: python -m forge serve --env-file ../.env
# DEEPSEEK_API_KEY is also accepted from the explicitly selected file.
PATCHFORGE_IMAGE=python:3.12-slim
